{
  "files.associations": {
    // C/C++
    "*.c": "c",
    "*.h": "c",
    "*.cpp": "cpp",
    "*.hpp": "cpp",

    // Assembler
    "*.s": "asm-collection",
    "*.S": "asm-collection",
    "*.asm": "asm-collection",

    // Linker script
    "*.ld": "ld",
    
    // json
    "*.json": "jsonc"
  }
}